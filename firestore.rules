rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function ownsUserData(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validProfile(userId) {
      return request.resource.data.keys().hasOnly([
        'uid', 'displayName', 'email', 'emailVerified', 'createdAt', 'updatedAt',
        'childrenMigrationVersion', 'childrenMigrationChildId'
      ])
      && request.resource.data.uid == userId
      && request.resource.data.emailVerified is bool;
    }

    function validChild() {
      return request.resource.data.keys().hasOnly([
        'childVersion', 'name', 'grade', 'birthYear', 'avatar', 'createdAt', 'updatedAt'
      ])
      && request.resource.data.childVersion == 1
      && request.resource.data.name is string
      && request.resource.data.name.size() > 0
      && request.resource.data.name.size() <= 60
      && request.resource.data.grade == 'grade-1'
      && (request.resource.data.birthYear == null
        || (request.resource.data.birthYear is int
          && request.resource.data.birthYear >= 2000
          && request.resource.data.birthYear <= 2100))
      && request.resource.data.avatar is string
      && request.resource.data.avatar in ['🧒', '👧', '👦', '🐻', '🐰', '🐼', '🦊', '🐱']
      && request.resource.data.createdAt is timestamp
      && request.resource.data.updatedAt is timestamp;
    }

    function validProgress() {
      return request.resource.data.keys().hasOnly([
        'progressVersion', 'levels', 'history', 'studyTime', 'totalCompleted',
        'updatedAt', 'syncReason'
      ])
      && request.resource.data.progressVersion == 2
      && request.resource.data.levels is map
      && request.resource.data.history is list
      && request.resource.data.history.size() <= 50
      && request.resource.data.studyTime is map
      && request.resource.data.totalCompleted is int
      && request.resource.data.totalCompleted >= 0
      && request.resource.data.syncReason is string;
    }

    function validChildSettings() {
      return request.resource.data.keys().hasOnly([
        'settingsVersion', 'dailyTimeLimitMinutes', 'dailyLessonLimit',
        'breakEnabled', 'breakAfterMinutes', 'breakDurationMinutes',
        'allowedTimeEnabled', 'allowedStartTime', 'allowedEndTime',
        'soundEnabled', 'speechEnabled', 'updatedAt'
      ])
      && request.resource.data.settingsVersion == 1
      && (request.resource.data.dailyTimeLimitMinutes == null
        || (request.resource.data.dailyTimeLimitMinutes is int
          && request.resource.data.dailyTimeLimitMinutes >= 1
          && request.resource.data.dailyTimeLimitMinutes <= 1440))
      && (request.resource.data.dailyLessonLimit == null
        || (request.resource.data.dailyLessonLimit is int
          && request.resource.data.dailyLessonLimit >= 1
          && request.resource.data.dailyLessonLimit <= 100))
      && request.resource.data.breakEnabled is bool
      && (request.resource.data.breakAfterMinutes == null
        || (request.resource.data.breakAfterMinutes is int
          && request.resource.data.breakAfterMinutes >= 1
          && request.resource.data.breakAfterMinutes <= 240))
      && (request.resource.data.breakDurationMinutes == null
        || (request.resource.data.breakDurationMinutes is int
          && request.resource.data.breakDurationMinutes >= 1
          && request.resource.data.breakDurationMinutes <= 120))
      && (!request.resource.data.breakEnabled
        || (request.resource.data.breakAfterMinutes is int
          && request.resource.data.breakDurationMinutes is int))
      && request.resource.data.allowedTimeEnabled is bool
      && (request.resource.data.allowedStartTime == null
        || (request.resource.data.allowedStartTime is string
          && request.resource.data.allowedStartTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')))
      && (request.resource.data.allowedEndTime == null
        || (request.resource.data.allowedEndTime is string
          && request.resource.data.allowedEndTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')))
      && (!request.resource.data.allowedTimeEnabled
        || (request.resource.data.allowedStartTime is string
          && request.resource.data.allowedEndTime is string))
      && request.resource.data.soundEnabled is bool
      && request.resource.data.speechEnabled is bool
      && request.resource.data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow read: if ownsUserData(userId);
      allow create, update: if ownsUserData(userId) && validProfile(userId);

      match /progress/{courseId} {
        allow read: if ownsUserData(userId) && courseId == 'math-grade-1';
      }

      match /children/{childId} {
        allow read: if ownsUserData(userId);
        allow create, update: if ownsUserData(userId) && validChild();

        match /progress/{courseId} {
          allow read: if ownsUserData(userId) && courseId == 'math-grade-1';
          allow create, update: if ownsUserData(userId)
            && courseId == 'math-grade-1'
            && validProgress();
        }

        match /settings/{settingsId} {
          allow read: if ownsUserData(userId);
          allow create, update: if ownsUserData(userId)
            && settingsId == 'learning'
            && validChildSettings();
        }
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}