rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function ownsUserData(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validProfile(userId) {
      return request.resource.data.keys().hasOnly([
        'uid', 'displayName', 'email', 'emailVerified', 'createdAt', 'updatedAt',
        'childrenMigrationVersion', 'childrenMigrationChildId'
      ])
      && request.resource.data.uid == userId
      && request.resource.data.emailVerified is bool;
    }

    function validChild() {
      return request.resource.data.keys().hasOnly([
        'childVersion', 'name', 'grade', 'birthYear', 'avatar', 'createdAt', 'updatedAt'
      ])
      && request.resource.data.childVersion == 1
      && request.resource.data.name is string
      && request.resource.data.name.size() > 0
      && request.resource.data.name.size() <= 60
      && request.resource.data.grade == 'grade-1'
      && (request.resource.data.birthYear == null
        || (request.resource.data.birthYear is int
          && request.resource.data.birthYear >= 2000
          && request.resource.data.birthYear <= 2100))
      && request.resource.data.avatar is string
      && request.resource.data.avatar in ['🧒', '👧', '👦', '🐻', '🐰', '🐼', '🦊', '🐱']
      && request.resource.data.createdAt is timestamp
      && request.resource.data.updatedAt is timestamp;
    }

    function validProgress() {
      return request.resource.data.keys().hasOnly([
        'progressVersion', 'levels', 'history', 'studyTime', 'totalCompleted',
        'updatedAt', 'syncReason'
      ])
      && request.resource.data.progressVersion == 2
      && request.resource.data.levels is map
      && request.resource.data.history is list
      && request.resource.data.history.size() <= 50
      && request.resource.data.studyTime is map
      && request.resource.data.totalCompleted is int
      && request.resource.data.totalCompleted >= 0
      && request.resource.data.syncReason is string;
    }

    match /users/{userId} {
      allow read, delete: if ownsUserData(userId);
      allow create, update: if ownsUserData(userId) && validProfile(userId);

      match /progress/{courseId} {
        allow read: if ownsUserData(userId) && courseId == 'math-grade-1';
      }

      match /children/{childId} {
        allow read: if ownsUserData(userId);
        allow create, update: if ownsUserData(userId) && validChild();

        match /progress/{courseId} {
          allow read: if ownsUserData(userId) && courseId == 'math-grade-1';
          allow create, update: if ownsUserData(userId)
            && courseId == 'math-grade-1'
            && validProgress();
        }
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}